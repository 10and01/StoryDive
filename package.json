{
  "name": "ruju",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "opennextjs-cloudflare dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "start": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/deploy-cloudflare.mjs",
    "upload": "opennextjs-cloudflare build && node scripts/deploy-cloudflare.mjs --upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts --include-runtime=false",
    "lint": "eslint",
    "test": "tsx --test src/lib/works/parser.test.ts src/lib/models/provider-client.test.ts src/lib/models/crypto.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "i18next": "^25.8.14",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "openai": "^4.104.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^16.5.6",
    "shadcn": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250914.0",
    "@opennextjs/cloudflare": "^1.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.36.0"
  }
}
