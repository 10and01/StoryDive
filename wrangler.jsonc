{
  // Cloudflare Workers 部署配置（OpenNext 适配 Next.js）。
  // 首次部署前：
  //   1. `wrangler d1 create ruju-db`，把返回的 database_id 填到下面
  //   2. `bun run db:migrate:remote` 应用数据库迁移
  //   3. `wrangler secret put` 配置生产密钥（见 README「部署」一节）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storydive",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // 自定义域（国内可直访；workers.dev 被墙）。区激活后由 wrangler deploy 自动建 DNS + 证书
  "routes": [
    { "pattern": "storydive-10wtw01.org", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // 生产环境固定要求知乎真实登录后才能创建、保存和配置模型。
    "GUEST_EXPERIENCE": "preview"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruju-db",
      "database_id": "5089a48e-86dd-433d-bb80-fc7e4d5c5361",
      "migrations_dir": "src/lib/db/migrations"
    }
  ],
  // 上传小说使用 Workers KV。单值上限 25 MiB，覆盖产品的 20 MiB 上传限制，
  // 且无需启用 R2 计费；此场景只在上传和生成时各读写一次。
  "kv_namespaces": [
    {
      "binding": "WORK_UPLOADS",
      "id": "0a3e475d7d4d4b2484fedceaccffa425"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "STORY_GENERATION_QUEUE",
        "queue": "ruju-story-generation"
      }
    ],
    "consumers": [
      {
        "queue": "ruju-story-generation",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 4,
        "dead_letter_queue": "ruju-story-generation-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  // 保留 dashboard「变量和机密」里配置的环境变量：wrangler deploy 默认会
  // 清掉不在本文件里声明的变量，不设 true 则每次 git push 部署都会抹掉面板配置。
  "keep_vars": true
}
