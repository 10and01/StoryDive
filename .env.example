# ===== AI（OpenAI 兼容协议）=====
# 知乎黑客松统一接入网关，填入你的 API Key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai-next.com/v1
OPENAI_MODEL=deepseek-v4-flash

# ===== 会话签名（必填，生产请更换）=====
SESSION_SECRET=

# ===== 知乎开放平台 =====
# 热榜 / 用户数据 API 鉴权（developer.zhihu.com 个人中心申请）
ZHIHU_ACCESS_SECRET=
# 知乎黑客松 OAuth（赛事页面分配，明天开放后填写；不填则全站走游客会话）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# OAuth 回调地址（默认自动推导为 {站点域名}/api/auth/callback，赛事页面登记的回调需与其完全一致）
# ZHIHU_OAUTH_REDIRECT_URI=

# ===== 站点元信息 =====
NEXT_PUBLIC_APP_TITLE=入局
NEXT_PUBLIC_APP_DESCRIPTION=知乎盐言故事的互动叙事游乐场：入局一个名场面，对戏、分叉、改写，走出你的结局。
NEXT_PUBLIC_SITE_URL=

# ===== 本地测试开关 =====
# open = 游客免登录体验全部功能（仅本地测试用）；生产环境不要配置，游客只能预览
# NEXT_PUBLIC_GUEST_EXPERIENCE=open
